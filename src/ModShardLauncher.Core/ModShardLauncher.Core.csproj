<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The assembly name is a compatibility contract with already published .sml mods:
         their assembly references point at "ModShardLauncher". Do not rename it. -->
    <AssemblyName>ModShardLauncher</AssemblyName>
    <RootNamespace>ModShardLauncher</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModShardPackerReference" Version="1.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- UndertaleModTool libraries are consumed as frozen binaries (see docs/architecture.md). -->
    <Reference Include="UndertaleModLib">
      <HintPath>Reference\UndertaleModLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UndertaleModTool">
      <HintPath>Reference\UndertaleModTool.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Codes\**\*.gml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference assemblies used by the in-process Roslyn compiler for mod projects.
         They are copied next to the executable (not into a sub folder) because the compiler
         resolves netstandard/System.* from the application directory. -->
    <Content Include="ModReference\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
